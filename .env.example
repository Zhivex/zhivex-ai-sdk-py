# Zhivex AI SDK local environment template.
# Copy this file to .env and fill only the providers you want to run.

# Scope live smoke runs. Leave empty to try every configured provider.
ZHIVEX_SMOKE_PROVIDERS=
# With a provider selector, require every selected provider; otherwise require at least one.
ZHIVEX_SMOKE_STRICT=
# Also run a real run_agent -> local tool -> tool result loop for each configured provider.
ZHIVEX_SMOKE_AGENTS=
# Release workflows set this to smoke the installed wheel instead of local src/.
ZHIVEX_SMOKE_USE_INSTALLED=
# Exact-artifact release gates set these; normal local smokes can leave them empty.
ZHIVEX_RELEASE_SMOKE_POLICY=
ZHIVEX_SMOKE_ARTIFACT_PATH=
ZHIVEX_SMOKE_EVIDENCE_PATH=
# Supplied by GitHub Actions; local evidence falls back to git rev-parse HEAD.
GITHUB_SHA=

# OpenAI
OPENAI_API_KEY=
ZHIVEX_SMOKE_OPENAI_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ZHIVEX_SMOKE_ANTHROPIC_MODEL=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
ZHIVEX_SMOKE_AZURE_OPENAI_MODEL=

# Gemini
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=
ZHIVEX_SMOKE_GEMINI_MODEL=

# Vertex AI
VERTEX_ACCESS_TOKEN=
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=
GCLOUD_PROJECT=
VERTEX_LOCATION=us-central1
ZHIVEX_SMOKE_VERTEX_MODEL=

# Optional Google media smoke checks.
ZHIVEX_SMOKE_GOOGLE_MEDIA=
ZHIVEX_SMOKE_GEMINI_IMAGE_MODEL=
ZHIVEX_SMOKE_GEMINI_VIDEO_MODEL=
ZHIVEX_SMOKE_GEMINI_MEDIA_MODEL=
ZHIVEX_SMOKE_VERTEX_IMAGE_MODEL=
ZHIVEX_SMOKE_VERTEX_VIDEO_MODEL=
ZHIVEX_SMOKE_VERTEX_MEDIA_MODEL=

# Ollama
ZHIVEX_SMOKE_OLLAMA_MODEL=
ZHIVEX_SMOKE_OLLAMA_BASE_URL=http://localhost:11434/v1

# Qwen / Alibaba Cloud Model Studio
DASHSCOPE_API_KEY=
QWEN_API_KEY=
ZHIVEX_SMOKE_QWEN_MODEL=
ZHIVEX_SMOKE_QWEN_REGION=intl
ZHIVEX_SMOKE_QWEN_BASE_URL=
ZHIVEX_SMOKE_QWEN_RESPONSES_BASE_URL=
ZHIVEX_SMOKE_QWEN_EMBEDDING_MODEL=
ZHIVEX_SMOKE_QWEN_ASR_MODEL=
ZHIVEX_SMOKE_QWEN_ASR_AUDIO_PATH=
ZHIVEX_SMOKE_QWEN_ASR_MEDIA_TYPE=audio/wav
ZHIVEX_SMOKE_QWEN_TTS_MODEL=
ZHIVEX_SMOKE_QWEN_TTS_LANGUAGE_TYPE=English

# vLLM
VLLM_API_KEY=
VLLM_BASE_URL=http://localhost:8000/v1
ZHIVEX_SMOKE_VLLM_MODEL=
ZHIVEX_SMOKE_VLLM_BASE_URL=http://localhost:8000/v1
ZHIVEX_SMOKE_VLLM_API_KEY=

# Kimi / Moonshot
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
KIMI_API_KEY=
ZHIVEX_SMOKE_KIMI_MODEL=
ZHIVEX_SMOKE_KIMI_BASE_URL=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ZHIVEX_SMOKE_DEEPSEEK_MODEL=deepseek-v4-flash
ZHIVEX_SMOKE_DEEPSEEK_BASE_URL=

# Meta Model API (Tier-1 portable core; native extras remain Beta).
# Use Standard for sensitive data. Contributor is appropriate only for explicit,
# non-sensitive synthetic smokes such as the cost-optimized 0.20.0 release policy.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
ZHIVEX_SMOKE_META_MODEL=
ZHIVEX_SMOKE_META_BASE_URL=
ZHIVEX_SMOKE_META_CERTIFICATION=

# Optional Postgres-backed agent memory/checkpoint tests.
ZHIVEX_TEST_POSTGRES_DSN=

# Production FastAPI agent example. Keep the token in a secret manager.
DATABASE_URL=
ZHIVEX_AGENT_API_TOKEN=
ZHIVEX_TENANT_ID=
ZHIVEX_AGENT_TABLE_PREFIX=zhivex_agent
ZHIVEX_AGENT_MODEL=
ZHIVEX_RATE_LIMIT_PER_MINUTE=60

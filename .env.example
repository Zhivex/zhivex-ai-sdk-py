# Zhivex AI SDK local environment template.
# Copy this file to .env and fill only the providers you want to run.

# Scope live smoke runs. Leave empty to try every configured provider.
ZHIVEX_SMOKE_PROVIDERS=

# OpenAI
OPENAI_API_KEY=
ZHIVEX_SMOKE_OPENAI_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ZHIVEX_SMOKE_ANTHROPIC_MODEL=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
ZHIVEX_SMOKE_AZURE_OPENAI_MODEL=

# Gemini
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=
ZHIVEX_SMOKE_GEMINI_MODEL=

# Vertex AI
VERTEX_ACCESS_TOKEN=
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=
GCLOUD_PROJECT=
VERTEX_LOCATION=us-central1
ZHIVEX_SMOKE_VERTEX_MODEL=

# Optional Google media smoke checks.
ZHIVEX_SMOKE_GOOGLE_MEDIA=
ZHIVEX_SMOKE_GEMINI_IMAGE_MODEL=
ZHIVEX_SMOKE_GEMINI_VIDEO_MODEL=
ZHIVEX_SMOKE_GEMINI_MEDIA_MODEL=
ZHIVEX_SMOKE_VERTEX_IMAGE_MODEL=
ZHIVEX_SMOKE_VERTEX_VIDEO_MODEL=
ZHIVEX_SMOKE_VERTEX_MEDIA_MODEL=

# Ollama
ZHIVEX_SMOKE_OLLAMA_MODEL=
ZHIVEX_SMOKE_OLLAMA_BASE_URL=http://localhost:11434/v1

# Qwen / Alibaba Cloud Model Studio
DASHSCOPE_API_KEY=
QWEN_API_KEY=
ZHIVEX_SMOKE_QWEN_MODEL=
ZHIVEX_SMOKE_QWEN_REGION=intl
ZHIVEX_SMOKE_QWEN_BASE_URL=
ZHIVEX_SMOKE_QWEN_RESPONSES_BASE_URL=
ZHIVEX_SMOKE_QWEN_EMBEDDING_MODEL=
ZHIVEX_SMOKE_QWEN_ASR_MODEL=
ZHIVEX_SMOKE_QWEN_ASR_AUDIO_PATH=
ZHIVEX_SMOKE_QWEN_ASR_MEDIA_TYPE=audio/wav
ZHIVEX_SMOKE_QWEN_TTS_MODEL=
ZHIVEX_SMOKE_QWEN_TTS_LANGUAGE_TYPE=English

# vLLM
VLLM_API_KEY=
VLLM_BASE_URL=http://localhost:8000/v1
ZHIVEX_SMOKE_VLLM_MODEL=
ZHIVEX_SMOKE_VLLM_BASE_URL=http://localhost:8000/v1
ZHIVEX_SMOKE_VLLM_API_KEY=

# Kimi / Moonshot native examples.
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
KIMI_API_KEY=

# Optional Postgres-backed agent memory/checkpoint tests.
ZHIVEX_TEST_POSTGRES_DSN=
